# Application Settings
APP_BASE_URL=http://localhost:8000
# For production with GetCirclo, change to your deployed URL:
# APP_BASE_URL=https://your-app.herokuapp.com
# APP_BASE_URL=https://your-app.fly.io
# APP_BASE_URL=https://your-domain.com

# LLM APIs
GEMINI_API_KEY=your_gemini_key_here
OPENROUTER_API_KEY=your_openrouter_key_here
LLM_PROVIDER=gemini
LLM_MODEL=qwen/qwq-32b-preview

# GetCirclo
GETCIRCLO_API_KEY=your_getcirclo_key
GETCIRCLO_JWT_TOKEN=your_jwt_token
GETCIRCLO_WHATSAPP_ENABLED=true
GETCIRCLO_MEMORY_ENABLED=true

# Other services...
FIRECRAWL_API_KEY=your_key
RAPIDAPI_KEY=your_key
APIFY_API_KEY=your_key
