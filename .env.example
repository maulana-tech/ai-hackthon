# Firecrawl API
FIRECRAWL_API_KEY=fc-YOUR-API-KEY

# GetCirclo Platform
# Option 1: JWT Token (Recommended) - Auto-expires in 2038
GETCIRCLO_JWT_TOKEN=YOUR-JWT-TOKEN

# Option 2: API Key (Fallback if JWT not available)
GETCIRCLO_API_KEY=your-getcirclo-api-key

# Feature Flags
GETCIRCLO_WHATSAPP_ENABLED=true
GETCIRCLO_MEMORY_ENABLED=true

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Lazada API (RapidAPI)
RAPIDAPI_KEY=your-rapidapi-key
LAZADA_API_HOST=lazada-api.p.rapidapi.com

# Apify
APIFY_API_KEY=your-apify-api-key

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com

# Twilio (WhatsApp)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+14155238886

# Database
DATABASE_URL=sqlite:///./data/trendscout.db

# Redis (for caching)
REDIS_URL=redis://localhost:6379/0

# Application Settings
APP_NAME=TrendScout Supplier Connector
APP_VERSION=1.0.0
DEBUG=true
LOG_LEVEL=INFO

# Agent Configuration
MAX_RETRIES=3
TIMEOUT_SECONDS=120
SCRAPING_SPEED=10
CACHE_TTL_HOURS=24
